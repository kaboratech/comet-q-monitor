#!/bin/sh

title() {
    printf '\033[1;36m%s\033[0m\n' "$1"
}

section() {
    printf '\n\033[1;34m%s\033[0m\n' "$1"
}

title "========== GLKVM INFO =========="
printf '\033[1;32mHostname: %s\033[0m\n' "$(hostname)"

section "========== SYSTEM =========="
cat /etc/os-release 2>/dev/null
uname -a

section "========== UPTIME =========="
uptime

section "========== CPU =========="
grep -E 'model name|Processor|Hardware' /proc/cpuinfo | sort -u

section "========== MEMORY =========="
free -h

section "========== STORAGE =========="
df -h

section "========== TEMPERATURE =========="
for f in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$f" ] && printf '\033[1;33m%s: %s\033[0m\n' "$f" "$(cat "$f")"
done

section "========== NETWORK =========="
ip -brief link | awk '{print $1, $2}'

section "========== TAILSCALE =========="
if tailscale status >/dev/null 2>&1; then
    printf '\033[1;32mTailscale: CONNECTED\033[0m\n'
else
    printf '\033[1;31mTailscale: DISCONNECTED\033[0m\n'
fi
